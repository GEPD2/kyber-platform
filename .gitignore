# Secrets: the real environment. Only the template with placeholders is tracked.
.env
.env.*
!.env.example
*.env
secrets/
*.secret
*.secrets

# TLS material: never commit private keys or certificates.
nginx/certs/*
!nginx/certs/README.md
*.pem
*.key
*.crt
*.csr
*.p12
*.pfx
*.jks

# SSH keys and credential stores that can end up in a working tree.
id_rsa*
id_ed25519*
id_ecdsa*
.netrc
.npmrc
.pypirc
.git-credentials
credentials.json
*.kdbx

# Private vulnerability log: findings and fixes stay on this machine.
SECURITY_NOTES.md
SECURITY_NOTES*.md

# Claude Code: per-project settings, memory and local notes.
.claude/
**/.claude/
CLAUDE.local.md

# Database dumps and backups (contain user data and password hashes).
backups/
*.sql.gz
*.dump
# The schema is the only SQL file meant to be tracked.
*.sql
!mysql/init/*.sql

# Logs and runtime data.
*.log
logs/
mysql_data/
redis_data/

# Python
__pycache__/
*.pyc
*.pyo
.venv/
venv/
*.egg-info/
.pytest_cache/
.mypy_cache/
.coverage

# Frontend build
frontend/node_modules/
frontend/.next/
frontend/out/
frontend/next-env.d.ts
frontend/tsconfig.tsbuildinfo

# OS
.DS_Store
Thumbs.db

# Editors
.vscode/
.idea/
*.swp
*.swo
